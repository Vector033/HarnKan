# Local values come from `npx supabase status -o env` after `npm run db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Slip reading. Without a key the slip upload says AI reading is not set up.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Server only (never NEXT_PUBLIC_): lets the slip route record slip-backed payments.
SUPABASE_SECRET_KEY=
# Shows "Sign in with Google" once the provider is set up (README "Google sign-in").
NEXT_PUBLIC_GOOGLE_AUTH=
