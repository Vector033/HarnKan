# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/

# real slips must never be committed (PDPA) — keep them in eval/slips-private/
eval/slips-private/
supabase/.temp/
supabase/.branches/

# local editor/agent config
.claude/

.vercel
.env*
deploy/supabase/.temp/

# impeccable runtime
.impeccable/mocks/decision/serve.txt
.impeccable/mocks/decision/answer.txt

# Google OAuth client downloads hold the secret
client_secret_*.json

# working notes for coding sessions, kept out of the repo
HANDOFF.md
CLAUDE_DESIGN_GUIDE.md
