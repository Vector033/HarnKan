      "css": ":host,:root{--color-ink:#14302b;--color-ink-2:#1f443d;--color-ground:#eef1ef;--color-paper:#fff;--color-muted:#4f625d;--color-line:#d3dcd8;--color-perf:#a9b8b2;--color-serial:#a3271f;--color-owe:#a3271f;--color-wait:#8a5300;--color-wait-soft:#fbefd6;--color-ok:#1d6b4a;--color-pp:#1b3f73;--color-t0:#f6cdd6;--color-t1:#c4e8d6;--radius-coupon:10px;--ease-out-expo:cubic-bezier(0.16,1,0.3,1)} .ds-pp{font-family:Anuphan,system-ui,sans-serif;max-width:300px;padding:14px 16px 20px;border-radius:var(--radius-coupon);background:var(--color-pp);color:#fff;text-align:center}.ds-pp-name{font-size:14px;font-weight:600}.ds-pp-qr{width:160px;aspect-ratio:1;margin:12px auto 0;border:8px solid #fff;border-radius:8px;background:#fff repeating-conic-gradient(#14302b 0 25%,#fff 0 50%) 0 0/16px 16px}.ds-pp-amt{margin-top:16px;font-family:Kanit,Anuphan,system-ui,sans-serif;font-variant-numeric:tabular-nums;font-size:34px;font-weight:600;line-height:1}.ds-pp-to{margin-top:8px;font-size:16px;color:#d6e2f3}"
