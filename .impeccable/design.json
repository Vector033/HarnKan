      "html": "<button class=\"ds-btn-primary\">ได้รับแล้ว</button>",
      "css": ":host,:root{--color-ink:#14302b;--color-ink-2:#1f443d;--color-ground:#eef1ef;--color-paper:#fff;--color-muted:#4f625d;--color-line:#d3dcd8;--color-perf:#a9b8b2;--color-serial:#a3271f;--color-owe:#a3271f;--color-wait:#8a5300;--color-wait-soft:#fbefd6;--color-ok:#1d6b4a;--color-pp:#1b3f73;--color-t0:#f6cdd6;--color-t1:#c4e8d6;--radius-coupon:10px;--ease-out-expo:cubic-bezier(0.16,1,0.3,1)} .ds-btn-primary{font-family:Anuphan,system-ui,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:12px 20px;border:0;border-radius:8px;background:var(--color-ink);color:#fff;font-size:16px;font-weight:600;cursor:pointer;transition:background-color 150ms}.ds-btn-primary:hover,.ds-btn-primary:active{background:var(--color-ink-2)}.ds-btn-primary:focus-visible{outline:2px solid var(--color-ink);outline-offset:2px}.ds-btn-primary:disabled{opacity:.45;cursor:not-allowed}"
    },
    {
